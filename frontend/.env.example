# Frontend (Vite). Copy to frontend/.env — never commit that file.
# Leave values blank for a local smoke test. The site still renders.

# Firebase web app config. These values are public (they ship in the browser).
# They are not a service-account private key. Blank keeps Login visible and
# explains that the Google button needs this config at build time.
# Names containing SECRET, PASSWORD, TOKEN, WEBHOOK, DATABASE, PRIVATE, or
# CREDENTIAL are refused at build time so they cannot enter the client bundle.
# Do not set VITE_FIREBASE_PRIVATE_KEY or any service-account field here.
# Production builds do not emit source maps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional. Copy from the Firebase web app snippet if you have them.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# API origin with no trailing slash.
# Leave empty in local dev so the Vite proxy forwards /api to the backend.
# Production: leave empty and reverse-proxy /api, or set https://api.koliath.in
# Do not set http://localhost here for a production build — it is ignored.
VITE_API_BASE=

# Optional store or download URLs. Blank buttons say the link is coming
# (Diabetic Buddy still opens /diabetic-app) instead of a contact form.
VITE_DOWNLOAD_SAPIENT=
VITE_DOWNLOAD_ADVERTS=
VITE_DOWNLOAD_ADVERTS_REWARDS=
VITE_DOWNLOAD_ADVERT_COHORT=
VITE_DOWNLOAD_DIABETIC_BUDDY=

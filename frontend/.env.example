# Frontend (Vite). Copy to frontend/.env — never commit that file.
# Leave values blank for a local smoke test. The site still renders.

# Google OAuth Web client ID. Must match backend GOOGLE_CLIENT_ID.
# Blank disables Sign-In and shows setup copy on /earn.
VITE_GOOGLE_CLIENT_ID=

# API origin with no trailing slash.
# Leave empty in local dev so the Vite proxy forwards /api to the backend.
# Production: leave empty and reverse-proxy /api, or set https://api.koliath.in
# Do not set http://localhost here for a production build — it is ignored.
VITE_API_BASE=

# Public inbox shown on Contact. Not a secret.
VITE_CONTACT_EMAIL=hello@koliath.in

# Optional store or download URLs. Blank buttons ask Contact (or open
# /diabetic-app for Diabetic Buddy) instead of inventing a store listing.
VITE_DOWNLOAD_SAPIENT=
VITE_DOWNLOAD_ADVERTS=
VITE_DOWNLOAD_ADVERTS_REWARDS=
VITE_DOWNLOAD_ADVERT_COHORT=
VITE_DOWNLOAD_DIABETIC_BUDDY=

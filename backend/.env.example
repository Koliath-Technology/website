# Backend. Copy to backend/.env — never commit that file.
# Local smoke test: you can start with these defaults. Postgres is only
# required when a route actually queries the database.

# Server
PORT=3000
NODE_ENV=development

# Postgres. Required in production (no default). Local default is only used
# when NODE_ENV is not production.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/mydb

# Firebase Admin. All three are required before login or protected routes succeed.
# In production a missing value fails closed (HTTP 503). Never commit the JSON
# key file, and never copy FIREBASE_PRIVATE_KEY into a VITE_ variable.
# Paste the PEM with escaped newlines (\n), as dotenv and Railway expect.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared secret for trusted app backends posting qualification events.
# Required unless NODE_ENV is exactly "development". Unset NODE_ENV fails closed.
# Generate a long random value outside the repo. Never put this in a VITE_ variable.
APP_WEBHOOK_SECRET=

# Comma-separated allowed browser origins. Credentials are allowed only for
# these origins. Leave the site on the same origin in production.
CORS_ORIGINS=http://localhost:5173,https://koliath.in,https://www.koliath.in

# The admin console is not this service. It is https://admin.koliath.in
# (repo Koliath-Technology/website-admin, Railway service website-admin-deploy).
# Do not set ADMIN_* variables here. GET /admin on this site redirects there.
# Shared Postgres and Firebase Auth stay; this process does not mount /api/admin.

# Remote Postgres certificate check. false accepts Railway's public proxy cert.
# Set true when the database certificate is trusted (private network or pinned CA).
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Install verification. None of these are VITE_ variables.
# Verification token lifetime in seconds. When set, this overrides
# VERIFICATION_TOKEN_EXPIRY_MINUTES. Clamped to 60–86400.
# INSTALL_TOKEN_TTL_SECONDS=1800

# Rewards program. The API is the source of truth; the Earn page reads these
# from GET /api/rewards/program. Install payouts still use each app's
# points_awarded (admin approval). APP_DOWNLOAD_REWARD_COINS is the published
# download number and the admin form default.
FIRST_LOGIN_REWARD_COINS=10
APP_DOWNLOAD_REWARD_COINS=25
REFERRAL_REWARD_COINS=20
GIFT_CARD_COST_COINS=200
GIFT_CARD_VALUE_INR=100
REFERRALS_REQUIRED_FOR_REDEMPTION=3
VERIFICATION_TOKEN_EXPIRY_MINUTES=1440
# Salt for hashed IP velocity keys. Use a long random value in production.
INSTALL_IP_HASH_SALT=
# Set true to require attestation on every verify. v1 stubs then fail closed.
# Leave unset so attestation stays optional and client ids are fraud signals only.
INSTALL_REQUIRE_ATTESTATION=
